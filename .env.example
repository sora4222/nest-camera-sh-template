# Example secrets file. `make setup` copies it to .env (git-ignored).
# 1Password references (op://vault/item/field) are filled in by `op run` when `op` is
# installed; plain values work too. Only fill in what you turned on in config.toml.

# PostgreSQL, for event_log or state_store "postgres". `make db` starts this one in Docker.
CAMWATCH_DATABASE_URL=postgresql://camwatch:camwatch@127.0.0.1:5432/camwatch

# Camera "nest": Google Device Access, used by googlenestcam.
# GOOGLENESTCAM_CLIENT_ID=op://Private/camwatch-google/client_id
# GOOGLENESTCAM_CLIENT_SECRET=op://Private/camwatch-google/client_secret
# GOOGLENESTCAM_PROJECT_ID=op://Private/camwatch-google/project_id
# GOOGLENESTCAM_TOKEN_PATH=/home/you/.config/googlenestcam/token.json

# The Alexa skill's ID (amzn1.ask.skill....), for [alexa_skill].
# CAMWATCH_ALEXA_SKILL_ID=op://Private/camwatch-alexa/skill_id

# Speaker kind "voice_monkey".
# CAMWATCH_VOICE_MONKEY_TOKEN=op://Private/camwatch-voice-monkey/token

# Speaker kind "alexa_web": an Amazon refresh token (Atnr|...).
# CAMWATCH_ALEXA_REFRESH_TOKEN=op://Private/camwatch-alexa/refresh_token

# Speaker kind "alexa": the Smart Home skill (docs/alexa.md).
# CAMWATCH_ALEXA_SMART_HOME_SECRET=op://Private/camwatch-smart-home/secret
# CAMWATCH_ALEXA_CLIENT_ID=op://Private/camwatch-smart-home/client_id
# CAMWATCH_ALEXA_CLIENT_SECRET=op://Private/camwatch-smart-home/client_secret
